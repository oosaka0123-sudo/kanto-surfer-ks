{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oosaka0123-sudo/kanto-surfer-ks/schemas/validation-record.schema.json",
  "title": "Kanto Surfer KS validation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "spot_id",
    "raw_snapshot",
    "observation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "spot_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_snapshot": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path or immutable identifier for the matching raw Open-Meteo snapshot."
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "wave_size_label": {
          "type": ["string", "null"]
        },
        "wind_direction_label": {
          "type": ["string", "null"]
        },
        "wind_speed_mps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "reference_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Optional external/reference score used only for comparison, never copied into KS scoring."
        },
        "visual_note": {
          "type": ["string", "null"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "kind"],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["public_live", "commercial_live", "wave_report", "manual_visual", "other"]
              },
              "observed_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "note": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "ks_prediction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "wave_size_label": {
          "type": ["string", "null"]
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "difference_note": {
      "type": ["string", "null"]
    }
  }
}
