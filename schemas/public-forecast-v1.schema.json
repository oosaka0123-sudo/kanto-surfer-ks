{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://rss7.net/schemas/public-forecast-v1.schema.json",
  "title": "Kanto Surfer Public Forecast v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "timezone", "spot", "status", "wave_metric_label", "model_notice", "hourly", "weekly", "daily", "verified_observations"],
  "properties": {
    "schema_version": {"const": "public-forecast/1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_generated_at": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"const": "Asia/Tokyo"},
    "spot": {"$ref": "#/$defs/spot"},
    "status": {"enum": ["model_only", "model_plus_verified_observation"]},
    "wave_metric_label": {"type": "string", "minLength": 1},
    "model_notice": {"type": "string", "minLength": 1},
    "hourly": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/row"}},
    "weekly": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/weeklyRow"}},
    "daily": {"$ref": "#/$defs/daily"},
    "verified_observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "model_only"}}}, "then": {"properties": {"verified_observations": {"type": "array", "maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "model_plus_verified_observation"}}}, "then": {"properties": {"verified_observations": {"type": "array", "minItems": 1}}}}
  ],
  "$defs": {
    "spot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "area"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "area": {"type": "string"}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["time", "weather_label", "model_wave_height_m", "period_s", "wind_speed_ms", "wind_gust_ms", "wind_direction_label", "validation_status"],
      "properties": {
        "time": {"type": "string", "format": "date-time"},
        "weather_label": {"type": "string"},
        "model_wave_height_m": {"type": ["number", "null"], "minimum": 0},
        "period_s": {"type": ["number", "null"], "minimum": 0},
        "wind_speed_ms": {"type": ["number", "null"], "minimum": 0},
        "wind_gust_ms": {"type": ["number", "null"], "minimum": 0},
        "wind_direction_label": {"type": ["string", "null"]},
        "validation_status": {"const": "provisional"},
        "date": {"type": "string", "format": "date"}
      }
    },
    "weeklyRow": {
      "allOf": [
        {"$ref": "#/$defs/row"},
        {"type": "object", "required": ["date"]}
      ]
    },
    "daily": {
      "description": "Backend-aggregated daily summary over the inclusive JST window window_start_hour..window_end_hour. A metric is null unless every hourly sample in the window exists. The browser must not recompute it.",
      "type": "object", "additionalProperties": false,
      "required": ["days", "timezone", "window_start_hour", "window_end_hour", "weather_hour", "source_generated_at", "rows"],
      "properties": {
        "days": {"type": "integer", "minimum": 1, "maximum": 10},
        "timezone": {"const": "Asia/Tokyo"},
        "window_start_hour": {"const": 5},
        "window_end_hour": {"const": 17},
        "weather_hour": {"const": 11},
        "source_generated_at": {"type": ["string", "null"], "format": "date-time"},
        "rows": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/dailyRow"}}
      }
    },
    "dailyRow": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "weekday", "model_wave_height_min_m", "model_wave_height_max_m", "wind_speed_mean_ms", "wind_direction_mean_deg", "wind_direction_label", "weather_code", "weather_label", "wave_samples", "wind_samples", "judgment"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "weekday": {"type": "integer", "minimum": 0, "maximum": 6, "description": "0=Sunday (JST)"},
        "model_wave_height_min_m": {"type": ["number", "null"], "minimum": 0},
        "model_wave_height_max_m": {"type": ["number", "null"], "minimum": 0},
        "wind_speed_mean_ms": {"type": ["number", "null"], "minimum": 0},
        "wind_direction_mean_deg": {"type": ["integer", "null"], "minimum": 0, "maximum": 359},
        "wind_direction_label": {"enum": ["北", "北東", "東", "南東", "南", "南西", "西", "北西", null]},
        "weather_code": {"type": ["integer", "null"], "minimum": 0},
        "weather_label": {"type": ["string", "null"]},
        "wave_samples": {"type": "integer", "minimum": 0, "maximum": 13},
        "wind_samples": {"type": "integer", "minimum": 0, "maximum": 13},
        "judgment": {"$ref": "#/$defs/dailyJudgment"}
      }
    },
    "dailyJudgment": {
      "description": "Daily surfability judgment. Kugenuma may emit a provisional 1-5 star model judgment; uncalibrated spots remain pending.",
      "type": "object", "additionalProperties": false,
      "required": ["status", "label", "emoji", "stars"],
      "properties": {
        "status": {"enum": ["pending", "provisional"]},
        "label": {"type": "string", "minLength": 1},
        "emoji": {"type": ["string", "null"]},
        "stars": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pending"}}},
          "then": {
            "properties": {
              "label": {"const": "検証中"},
              "emoji": {"type": "null"},
              "stars": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "provisional"}}},
          "then": {
            "properties": {
              "label": {"enum": ["諦めよ", "微妙", "できそう", "良さそう", "かなり良い"]},
              "emoji": {"enum": ["😴", "🤔", "🙂", "😄", "🔥"]},
              "stars": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "wave_size_label", "wind_direction_label", "wind_speed_ms", "source_count"],
      "properties": {
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "wave_size_label": {"type": ["string", "null"]},
        "wind_direction_label": {"type": ["string", "null"]},
        "wind_speed_ms": {"type": ["number", "null"], "minimum": 0},
        "source_count": {"type": "integer", "minimum": 2}
      }
    }
  }
}
